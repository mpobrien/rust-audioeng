// PM bell / chime
//
// Carrier modulated by a second oscillator at a non-integer frequency ratio.
// `level` is the peak phase deviation in cycles (the PM modulation index).
// A fast-decaying depth envelope makes the attack inharmonic and bright,
// then fades toward a pure sine — like a real struck bell.
//
// C:M ratio = 1:2.0  (close ratio — warm, deep bell with strong fundamental)
// depth env: fast decay, zero sustain (bright at strike, fades to pure sine)
// carrier env: slow decay, zero sustain (the tone rings and fades)

bell = patch {
  osc {
    shape  = sine,
    freq   = osc {
      freq   = freq * 2.0,
      level  = 2.5,
      depth  = adsr { attack = 0.001, decay = 0.8, sustain = 0, release = 0.1 },
      offset = freq
    }
  }
    | adsr { attack = 0.005, decay = 1.8, sustain = 0.0, release = 0.3 }
}

chime = phrase { dur=quarter, tempo=80, [c5 e5 g5 c6 _ g5 e5 c5] } | bell
