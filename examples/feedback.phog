// Oscillator self-feedback — DX7-style waveform distortion
//
// When an osc feeds its own output back into its phase, a pure sine gradually
// folds into richer waveforms as feedback increases:
//
//   feedback = 0.00  →  pure sine
//   feedback = 0.10  →  mild odd harmonics, slightly hollow
//   feedback = 0.28  →  sawtooth-like, strong harmonics
//   feedback ≈ 0.318 →  maximum stable output (1/π threshold)
//   feedback > 0.318 →  chaotic / noisy
//
// Here feedback is modulated by a slow envelope so the timbre evolves
// from clean to gritty over the note's duration, then releases clean.

growl = patch {
  osc {
    shape    = square,
    feedback = 0.1
  }
  | lpf { cutoff = osc{shape=square, freq=3, range=100..440} }
    | adsr { attack = 0.01, decay = 2.0, sustain = 0.6, release = 0.2 }
}

line = phrase { dur=half, tempo=80, [a2 a2 e2 e2] } | growl
